
# ============================================
# Swedish Election 2022 - Git ignore rules
# ============================================

# Original data - keep local until redistribution
# permissions and sizes have been checked
/Data/Raw/

# Processed datasets generated by R
/Data/Processed/

# Generated figures and tables
/Outputs/

# Mplus output and generated data files
*.out
*.gh5
*.chk
*.dat

# R temporary files
.Rhistory
.RData
.Ruserdata
.Rproj.user/

# renv installed packages
renv/library/
renv/staging/

# macOS
.DS_Store

# Temporary files
*.tmp
*.log

# Credentials and secrets
.env
.env.*
*.key
